# Service BentoML (phase 3.4) -- image séparée de l'API/des tests : bentoml
# n'est pas une dépendance du cœur du projet, pas la peine d'alourdir
# l'image app/CI pour une démonstration de serving alternatif.
FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 PIP_NO_CACHE_DIR=1

RUN apt-get update && apt-get install -y --no-install-recommends \
        git curl libgomp1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

RUN pip install torch==2.12.1 --index-url https://download.pytorch.org/whl/cpu

COPY pyproject.toml README.md ./
COPY src ./src
RUN pip install -e . && pip install bentoml==1.4.39

EXPOSE 3000
CMD ["bentoml", "serve", "projet_hydro.serving.bento_service:PredictionService", "--host", "0.0.0.0", "--port", "3000"]
