# Serveur MLflow, vu depuis l'HOTE (env conda). VIDE = suivi désactivé, c'est
# le défaut des tests et de la CI. Chargé par config.py au premier import.
# Dans les conteneurs, compose substitue le nom du service (http://mlflow:5000)
# dès que cette valeur est non vide -- voir x-env dans docker-compose.yml.
MLFLOW_TRACKING_URI=http://localhost:5000
