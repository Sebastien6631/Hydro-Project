# Copier en .env (gitignoré).
# Token DagsHub : https://dagshub.com/user/settings/tokens (Default Access Token).
DAGSHUB_USER=<votre_pseudo_dagshub>
DAGSHUB_TOKEN=<votre_token>

# Identité pour les commits de promotion (promotion.py, dans le conteneur).
GIT_AUTHOR_NAME=<votre_nom>
GIT_AUTHOR_EMAIL=<votre_email>

# Serveur MLflow, vu depuis l'HOTE (env conda). VIDE = suivi désactivé, c'est
# le défaut des tests et de la CI. Chargé par config.py au premier import.
# Dans les conteneurs, compose substitue le nom du service (http://mlflow:5000)
# dès que cette valeur est non vide -- voir x-env dans docker-compose.yml.
MLFLOW_TRACKING_URI=http://localhost:5000

# Stockage objet des artefacts MLflow (phase 2.6). Vide = valeurs par défaut
# minioadmin/minioadmin123 (dev local uniquement, cf. docker-compose.yml).
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# Sécurisation de l'API (phase 3.3). Vide (défaut) = authentification
# désactivée -- comportement des tests/CI. Non vide = clé à fournir dans
# l'en-tête `X-API-Key` pour /models et /predict.
API_KEY=
